# File system
if command -v eza &> /dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

alias ff="fzf --preview 'bat --style=numbers --color=always {}'"

if command -v zoxide &> /dev/null; then
  alias cd="zd"
  zd() {
    if [ $# -eq 0 ]; then
      builtin cd ~ && return
    elif [ -d "$1" ]; then
      builtin cd "$1"
    else
      z "$@" && printf "\U000F17A9 " && pwd || echo "Error: Directory not found"
    fi
  }
fi

open() {
  xdg-open "$@" >/dev/null 2>&1 &
}

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Tools
alias c='opencode'
alias ag='auggie'
alias d='docker'
alias tks='tmux kill-server'
n() {
  # 1. Handle the "no arguments" case (open current directory)
  if [ "$#" -eq 0 ]; then
    nvim .
    return
  fi

  # 2. Check if the file is NOT writable. 
  # If it doesn't exist yet, check if the parent directory is NOT writable.
  if [[ ( -f "$1" && ! -w "$1" ) || ( ! -f "$1" && ! -w "${1%/*}" ) ]]; then
    sudoedit "$@"
  else
    nvim "$@"
  fi
}
t() {
  # Use the first argument if provided, otherwise default to "Work"
  local session="${1:-Work}"
  
  # Try to attach, if that fails, create a new one with that name
  tmux attach -t "$session" 2>/dev/null || tmux new -s "$session"
}

# Sudo nvim
alias snvim='sudo -e'

# Git
alias lg='lazygit'

# Media server
media() {
    local action=$1
    if [[ "$action" == "start" || "$action" == "stop" || "$action" == "status" ]]; then
        sudo systemctl "$action" jellyfin sonarr bazarr radarr --no-pager
    else
        echo "Usage: media [start|stop|status]"
    fi
}
