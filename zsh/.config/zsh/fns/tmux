# Create a terminal dev layout
tdl() {
  if [[ -z $1 ]]; then
    echo "Usage: tdl <c|cx|codex|other_ai> [<second_ai>]"
    return 1
  fi
  [[ -z $TMUX ]] && { echo "You must start tmux to use tdl."; return 1; }

  local current_dir="${PWD}"
  local editor_pane ai_pane ai2_pane
  local ai="$1"
  local ai2="$2"

  editor_pane="$TMUX_PANE"

  tmux rename-window -t "$editor_pane" "$(basename "$current_dir")"
  tmux split-window -v -p 15 -t "$editor_pane" -c "$current_dir"
  ai_pane=$(tmux split-window -h -p 30 -t "$editor_pane" -c "$current_dir" -P -F '#{pane_id}')

  if [[ -n $ai2 ]]; then
    ai2_pane=$(tmux split-window -v -t "$ai_pane" -c "$current_dir" -P -F '#{pane_id}')
    tmux send-keys -t "$ai2_pane" "$ai2" C-m
  fi

  tmux send-keys -t "$ai_pane" "$ai" C-m

  sleep 0.1
  tmux respawn-pane -k -t "$editor_pane" -c "$current_dir" "zsh -i -c 'nvim .; zsh'"

  tmux select-pane -t "$editor_pane"
}

# Create multiple tdl windows with one per subdirectory
tdlm() {
  if [[ -z $1 ]]; then
    echo "Usage: tdlm <c|cx|codex|other_ai> [<second_ai>]"
    return 1
  fi
  [[ -z $TMUX ]] && { echo "You must start tmux to use tdlm."; return 1; }

  local ai="$1"
  local ai2="$2"
  local base_dir="$PWD"
  local first=true

  # Sanitize session name for tmux
  tmux rename-session "$(basename "$base_dir" | tr '.:' '--')"

  # Loop through subdirectories
  for dir in "$base_dir"/*(/N); do
    local dirpath="${dir%/}"

    if $first; then
      # Use C-u to clear any junk before running tdl
      tmux send-keys -t "$TMUX_PANE" C-u "cd '$dirpath' && tdl $ai $ai2" C-m
      first=false
    else
      # Create new window and wait a split second for the shell to init
      local pane_id=$(tmux new-window -c "$dirpath" -P -F '#{pane_id}')
      sleep 0.2 
      tmux send-keys -t "$pane_id" C-u "tdl $ai $ai2" C-m
    fi
  done
}

# Create a multi-pane swarm layout
tsl() {
  if [[ -z $1 || -z $2 ]]; then
    echo "Usage: tsl <pane_count> <command>"
    return 1
  fi
  [[ -z $TMUX ]] && { echo "You must start tmux to use tsl."; return 1; }

  local count="$1"
  local cmd="$2"
  local current_dir="${PWD}"
  local -a panes

  tmux rename-window -t "$TMUX_PANE" "$(basename "$current_dir")"
  panes+=("$TMUX_PANE")

  # 1. Create the panes
  while (( ${#panes} < count )); do
    local new_pane
    local split_target="${panes[-1]}"
    new_pane=$(tmux split-window -h -t "$split_target" -c "$current_dir" -P -F '#{pane_id}')
    panes+=("$new_pane")
    tmux select-layout -t "${panes[1]}" tiled
  done

  # 2. Distribute the commands with a safety clear
  # This prevents the '34' artifact from being swallowed by the command
  for pane in "${panes[@]}"; do
    # Interrupt and Clear line before sending the command
    tmux send-keys -t "$pane" C-c C-u "$cmd" C-m
  done

  tmux select-pane -t "${panes[1]}"
}
