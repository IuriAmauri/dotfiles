# Transcode a video to a good-balance 1080p
transcode-video-1080p() {
  # Ensure an input file was provided
  [[ -z "$1" ]] && { echo "Usage: transcode-video-1080p <file>"; return 1 }
  
  ffmpeg -i "$1" -vf scale=1920:1080 -c:v libx264 -preset fast -crf 23 -c:a copy "${1%.*}-1080p.mp4"
}

# Transcode a video to a good-balance 4K
transcode-video-4K() {
  [[ -z "$1" ]] && { echo "Usage: transcode-video-4K <file>"; return 1 }

  ffmpeg -i "$1" -c:v libx265 -preset slow -crf 24 -c:a aac -b:a 192k "${1%.*}-optimized.mp4"
}

# Transcode any image to JPG (high quality)
img2jpg() {
  local img="$1"
  shift
  [[ -z "$img" ]] && { echo "Usage: img2jpg <file> [magick_args]"; return 1 }

  magick "$img" "$@" -quality 95 -strip "${img%.*}-converted.jpg"
}

# Transcode any image to a small JPG (max 1080px wide)
img2jpg-small() {
  local img="$1"
  shift
  [[ -z "$img" ]] && { echo "Usage: img2jpg-small <file>"; return 1 }

  magick "$img" "$@" -resize 1080x\> -quality 95 -strip "${img%.*}-small.jpg"
}

# Transcode any image to a medium JPG (max 1800px wide)
img2jpg-medium() {
  local img="$1"
  shift
  [[ -z "$img" ]] && { echo "Usage: img2jpg-medium <file>"; return 1 }

  magick "$img" "$@" -resize 1800x\> -quality 95 -strip "${img%.*}-medium.jpg"
}

# Transcode any image to compressed-but-lossless PNG
img2png() {
  local img="$1"
  shift
  [[ -z "$img" ]] && { echo "Usage: img2png <file>"; return 1 }

  magick "$img" "$@" -strip -define png:compression-filter=5 \
    -define png:compression-level=9 \
    -define png:compression-strategy=1 \
    -define png:exclude-chunk=all \
    "${img%.*}-optimized.png"
}
