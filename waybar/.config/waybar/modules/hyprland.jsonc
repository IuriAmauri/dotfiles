{
  "hyprland/workspaces": {
    // "all-outputs": false,
    "active-only": false,
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "11": "1",
      "12": "2",
      "13": "3",
      "14": "4",
      "15": "5",
      "16": "6",
      "17": "7",
      "18": "8",
      "19": "9",
      "20": "0",
      "21": "1",
      "22": "2",
      "23": "3",
      "24": "4",
      "25": "5",
      "26": "6",
      "27": "7",
      "28": "8",
      "29": "9",
      "30": "0"
    },
    "persistent-workspaces": {
      "eDP-2": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "*": [
        "11",
        "12",
        "13",
        "14",
        "15"
      ],
      "HDMI-A-1": [
        "21",
        "22",
        "23",
        "24",
        "25"
      ]
    }
  },
  "hyprland/window": {
    "format": "<span weight='bold'>{class}</span>",
    "max-length": 100,
    "icon": true,
    "icon-size": 14
  }
}
