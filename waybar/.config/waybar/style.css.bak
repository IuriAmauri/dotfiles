@import "../omarchy/current/theme/waybar.css";
 * {
     background-color: transparent;
     color: @foreground;
     border: none;
     border-radius: 0;
     font-family: 'JetBrainsMono Nerd Font';
     font-size: 13px;
}
 window#waybar {
     background-color: rgba(0, 0, 0, 0);
}
/* Individual Pill Containers */
 .modules-left, .modules-center, .modules-right, #cpu, #memory, #disk {
     background-color: @background;
     border-radius: 16px;
     padding: 2px 12px;
     margin-top: 5px;
     margin-bottom: 5px;
     border: 1px solid rgba(255, 255, 255, 0.05);
}
/* System monitor spacing */
 #cpu, #memory, #disk {
     margin-right: 8px;
     min-width: 60px;
}
/* Layout Padding */
 .modules-left {
     margin-left: 12px;
}
 .modules-right {
     margin-right: 12px;
}
/* Interactive Hover */
 #cpu:hover, #memory:hover, #disk:hover, #workspaces button.active {
     color: @accent;
}
 #workspaces button {
     padding: 0 6px;
}
/* Spacing for status group */
 #clock, #bluetooth, #network, #pulseaudio, #battery, #group-tray-expander {
     margin: 0 8px;
}
